<?xml version='1.0' encoding='utf-8'?>
<santa xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="santa.xsd">
	
	
	<replicates>1</replicates>
	<simulation>
		<genome>
			
			<length>10000</length>
			<sequences>
				
			</sequences>
			<feature>
				<name>NS5</name>
				<type>aminoAcid</type>
				
				<coordinates>9200-11520</coordinates>
			</feature>
			<feature>
				<name>E</name>
				<type>aminoAcid</type>
				
				<coordinates>1200-2500</coordinates>
			</feature>
			<feature>
				<name>NS3</name>
				<type>aminoAcid</type>
				
				<coordinates>4800-6500</coordinates>
			</feature>
		</genome>

		<population>
			<populationSize>1000</populationSize>
			<inoculum>all</inoculum>
		</population>

		<fitnessFunction>
			<populationSizeDependentFitness>
				<feature>NS5</feature>
				<sites>1-100</sites>
				<declineRate>0.003</declineRate>
				<maxPopulationSize>30000</maxPopulationSize>
			</populationSizeDependentFitness>
		</fitnessFunction>

		<mutator>
			<nucleotideMutator>
				
				<mutationRate>2.5E-5</mutationRate>
				<rateBias>
	                    0.38 2.35 0.31
	                    1.65 0.28 4.52
	                    6.85 0.25 0.55
	                    1.15 2.41 0.92
	                </rateBias>
			</nucleotideMutator>
		</mutator>

		<replicator>
			<recombinantReplicator>
				
				<dualInfectionProbability>0.1</dualInfectionProbability>
				<recombinationProbability>0.010</recombinationProbability>
			</recombinantReplicator>
		</replicator>

		<epoch>
			<name>initial</name>
			<generationCount>5000</generationCount>			
		</epoch>
		
		<samplingSchedule>
			<sampler>
				<atFrequency>10</atFrequency>
				<sampleSize>50</sampleSize>
				<fileName>results/Zika_var39/frequency_%r.csv</fileName>
				<statistics />
			</sampler>
			<sampler>
				<atGeneration>end</atGeneration>
				<sampleSize>50</sampleSize>
				<fileName>results/Zika_var39/final_sample_%r.fasta</fileName>
				<statistics />
			</sampler>
		</samplingSchedule>
	</simulation>
</santa>